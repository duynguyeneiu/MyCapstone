# Copy to .env and fill in. .env is git-ignored – never commit real secrets.

# ---- SQL Server on the Windows host (see docker/sql/create-login.sql) ----
DB_HOST=host.docker.internal
DB_PORT=1433
DB_USER=happymart
DB_PASSWORD=

# ---- Shared secrets (must be identical for every service) ----
# Use the same values as in appsettings.json so tokens issued in dev keep working.
JWT_KEY=
INTERNAL_API_KEY=

# Development keeps Swagger UI enabled; use Production for the final deployment
ASPNETCORE_ENVIRONMENT=Development

# ---- SMS OTP: Console (OTP shown in `docker compose logs user-api`) or Esms ----
SMS_PROVIDER=Console
ESMS_API_KEY=
ESMS_SECRET_KEY=

# ---- VNPay sandbox ----
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# ---- MoMo test environment ----
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Public URL (ngrok) that forwards to http://localhost:5003, e.g.
# https://xxxx.ngrok-free.dev/api/Payment/momo-ipn
MOMO_IPN_URL=
