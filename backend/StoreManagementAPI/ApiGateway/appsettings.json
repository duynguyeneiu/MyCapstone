{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/{controller:regex(^(?i)(products|categories)$)}/{**rest}" }
      },
      "images": {
        "ClusterId": "catalog",
        "Match": { "Path": "/images/{**rest}" }
      },
      "order": {
        "ClusterId": "order",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/{controller:regex(^(?i)(order|cart|promotion)$)}/{**rest}" }
      },
      "payment": {
        "ClusterId": "payment",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/payment/{**rest}" }
      },
      "review": {
        "ClusterId": "review",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/reviews/{**rest}" }
      },
      "user": {
        "ClusterId": "user",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/{controller:regex(^(?i)(auth|user|otp)$)}/{**rest}" }
      }
    },
    "Clusters": {
      "catalog": { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "order": { "Destinations": { "d1": { "Address": "http://localhost:5002/" } } },
      "payment": { "Destinations": { "d1": { "Address": "http://localhost:5003/" } } },
      "review": { "Destinations": { "d1": { "Address": "http://localhost:5004/" } } },
      "user": { "Destinations": { "d1": { "Address": "http://localhost:5005/" } } }
    }
  }
}