            "format": "int32"
          },
          "receiverName": {
            "type": "string",
            "nullable": true
          },
          "receiverPhone": {
            "type": "string",
            "nullable": true
          },
          "shippingAddress": {
            "type": "string",
            "nullable": true
          },
          "paymentMethod": {
            "type": "string",
            "nullable": true
          },
          "promotionCode": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PosCheckoutRequest": {
        "type": "object",
        "properties": {
          "staffUserId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "receiverName": {
            "type": "string",
            "nullable": true
          },
          "paymentMethod": {
            "type": "string",
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosOrderItem"
            },
            "nullable": true
          },
          "promotionCode": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PosOrderItem": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int32"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "SavePromotionRequest": {
        "required": [
          "code",
          "discountType"
        ],
        "type": "object",
        "properties": {
          "code": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string"
          },
          "description": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "discountType": {
            "minLength": 1,
            "type": "string"
          },
          "discountValue": {
            "type": "number",
            "format": "double"
          },
          "minOrderValue": {
            "type": "number",
            "format": "double"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateCartItemRequest": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UpdateOrderStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdatePaymentStatusRequest": {
        "type": "object",
        "properties": {
          "paymentStatus": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ValidatePromotionRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "orderAmount": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Paste the JWT token from POST /api/Auth/login (UserService)",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
