{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
 
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ReviewContext": "Data Source=.;Initial Catalog=ReviewServiceDB;Integrated Security=True;Trust Server Certificate=True"
  },
  "Services": {
    "OrderService": "http://localhost:5002/",
    "CatalogService": "http://localhost:5001",
    "UserService": "http://localhost:5005"
  },
  "Jwt": {
    "Issuer": "UserService",
    "Audience": "RetailManagement",
    "ExpireMinutes": 60
  }
}
